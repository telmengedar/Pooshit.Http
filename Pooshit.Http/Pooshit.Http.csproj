<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <PackageId>Pooshit.Http</PackageId>
        <Version>0.9.2-preview</Version>
        <Title>Pooshit.Http</Title>
        <Authors>Toni Gottschall</Authors>
        <Description>Library simplifying http request handling</Description>
        <PackageReleaseNotes>Behaviour change: a followed redirect no longer carries the headers named in HttpService.SensitiveHeaders (Authorization, Cookie, Api-Key and the rest of the set) onto a hop whose target is not same-origin - scheme, host and port all compared - with the request that produced the redirect. A caller combining HttpOptions.FollowRedirects with a credential over a cross-origin redirect gets an unauthenticated hop, so a call that used to return 200 can now return 401 without throwing. Unaffected: same-origin redirects, callers who do not set FollowRedirects, and cross-origin redirects carrying no credential. If the credential has to travel, HttpOptions.UrlProcessor rewrites the target before the origin is resolved, which covers a redirect you can point back at a host you name yourself; for a genuine foreign-host authenticated redirect leave FollowRedirects off, take the raw 302 from Get&lt;HttpResponseMessage&gt; and issue the second call yourself.</PackageReleaseNotes>
        <PackageTags>http</PackageTags>
        <Company></Company>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/telmengedar/Pooshit.Http</PackageProjectUrl>
        <RepositoryUrl>https://github.com/telmengedar/Pooshit.Http</RepositoryUrl>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <Product>Pooshit.Http</Product>
    </PropertyGroup>

    <ItemGroup>
        <None Include="LICENSE" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Pooshit.Json" Version="0.3.40-preview" />
    </ItemGroup>
</Project>
